---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** path segment appended to the wordmark, e.g. '/writeups/pickle-rick' */
  crumb?: string;
  /** absolute URL to a per-page og:image; falls back to the site card */
  ogImage?: string;
}

const { title = 'zew0z :: security writeups & portfolio', description = 'CTF writeups, labs, and flags - a living record of breaking boxes to learn how they are built.', crumb = '', ogImage } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0e1c" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={ogImage ?? new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <a class="skip-link" href="#main">skip to content</a>

    <header class="site-header">
      <div class="container site-header-inner">
        <a class="wordmark" href="/"><span class="wm-prompt" aria-hidden="true">~/</span>zew0z<span class="tld">.io</span>{crumb && <span class="wm-path" aria-hidden="true">{crumb}</span>}</a>
        <nav class="site-nav" aria-label="primary">
          <a href="/portfolio.html">portfolio</a>
          <a href="/writeups.html">writeups</a>
          <a href="/#playground">shell</a>
          <a class="nav-github" href="https://github.com/zew0z" target="_blank" rel="noopener">github</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <pre class="footer-ascii" aria-hidden="true">{`# eof :: zew0z
# built with astro + vanilla css + one guest shell
# tip: view-source never hurt anyone`}</pre>
        <div class="footer-inner">
          <p class="footer-note">zew0z :: exit 0</p>
          <div class="footer-links">
            <a href="https://github.com/zew0z" target="_blank" rel="noopener">github</a>
            <a href="https://ko-fi.com/zew0z" target="_blank" rel="noopener">ko-fi</a>
            <a href="/feed.xml">rss</a>
          </div>
        </div>
      </div>
    </footer>

    <script src="../scripts/site.js"></script>
    <script src="../scripts/palette.js"></script>
  </body>
</html>
