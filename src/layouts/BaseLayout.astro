---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** path segment appended to the wordmark, e.g. '/writeups/pickle-rick' */
  crumb?: string;
  /** absolute URL to a per-page og:image; falls back to the site card */
  ogImage?: string;
}

const { title = 'zew0z :: security writeups & portfolio', description = 'CTF writeups, labs, and flags - a living record of breaking boxes to learn how they are built.', crumb = '', ogImage } = Astro.props;
const path = Astro.url.pathname;
const onPortfolio = path.includes('portfolio');
const onWriteups = path.includes('writeups') || /\/\d{4}\/\d{2}\/\d{2}\//.test(path);
const onHome = !onPortfolio && !onWriteups;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0e1c" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={ogImage ?? new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <a class="skip-link" href="#main">skip to content</a>

    <header class="site-header">
      <div class="container site-header-inner">
        <a href="/" class:list={['wordmark', { 'is-on': onHome }]} aria-label="zew0z home">
          <span class="header-dots" aria-hidden="true"><i class="tdot tdot-r"></i><i class="tdot tdot-y"></i><i class="tdot tdot-g"></i></span>
          <span class="wm-prompt" aria-hidden="true">~/</span><span class="wm-name" translate="no">zew0z</span><span class="tld">.io</span>{crumb && <span class="wm-path" aria-hidden="true">{crumb}</span>}{onHome && <span class="wm-cursor" aria-hidden="true"></span>}
        </a>
        <nav class="nav-dock" aria-label="primary">
          <span class="nav-glider" aria-hidden="true"></span>
          <span class="nav-ticks" aria-hidden="true"></span>
          <a href="/portfolio.html" class:list={['nav-pane', 'hue-green', { 'is-on': onPortfolio }]} aria-label="portfolio" aria-current={onPortfolio ? 'page' : undefined}><span class="nav-cmd" aria-hidden="true">./</span><span class="nav-label">portfolio</span></a>
          <a href="/writeups.html" class:list={['nav-pane', 'hue-teal', { 'is-on': onWriteups }]} aria-label="writeups" aria-current={onWriteups ? 'page' : undefined}><span class="nav-cmd" aria-hidden="true">./</span><span class="nav-label">writeups</span></a>
          <a class="nav-pane hue-sky nav-github" href="https://github.com/zew0z" target="_blank" rel="noopener" aria-label="github, opens in a new tab"><span class="nav-label">github</span><span class="nav-ext" aria-hidden="true">↗</span></a>
        </nav>
        <div class="header-session">
          <button type="button" class="header-cmd" data-palette-open aria-label="open command palette" title=": or ctrl+k">:</button>
          <a class="header-tty" href={onHome ? '#playground' : '/#playground'} aria-label="open guest shell">guest@zew0z</a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-hud">
        <span class="footer-host">guest@zew0z</span>
        <p class="footer-msg"># eof :: astro + vanilla css. view-source never hurt anyone</p>
        <nav class="footer-links" aria-label="elsewhere">
          <a href="https://github.com/zew0z" target="_blank" rel="noopener">github</a>
          <a href="https://ko-fi.com/zew0z" target="_blank" rel="noopener">ko-fi</a>
          <a href="/feed.xml">rss</a>
        </nav>
      </div>
    </footer>

    <script src="../scripts/site.js"></script>
    <script src="../scripts/palette.js"></script>
  </body>
</html>
