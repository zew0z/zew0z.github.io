---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShellPrompt from '../components/ShellPrompt.astro';
import AsciiArt from '../components/AsciiArt.astro';
import { LOST_BANNER } from '../lib/ascii';

const routes = [
  { href: '/', mode: 'drwx', name: '~' },
  { href: '/portfolio.html', mode: 'drwx', name: 'portfolio' },
  { href: '/writeups.html', mode: 'drwx', name: 'writeups' },
  { href: '/#playground', mode: '-rwx', name: 'guest-shell' },
  { href: '/feed.xml', mode: '-rw-', name: 'feed.xml' },
];
---

<BaseLayout title="404 :: zew0z" description="page not found">
  <section class="page-hero pf-hero err-hero">
    <div class="container pf-hero-grid">
      <div class="pf-hero-copy">
        <ShellPrompt path="~" command="cat /this-page-does-not-exist.html" />
        <h1 class="visually-hidden">404, page not found</h1>
        <AsciiArt art={LOST_BANNER} class="pf-ascii err-ascii" label="lost ascii banner" />
        <p class="page-lede">even nmap found nothing. pick a directory that exists.</p>
      </div>
      <aside class="term pf-index err-term" aria-label="missing path dump">
        <div class="term-chrome" aria-hidden="true">
          <span class="tdot tdot-r"></span>
          <span class="tdot tdot-y"></span>
          <span class="tdot tdot-g"></span>
          <span class="tname">guest@zew0z: ~</span>
        </div>
        <div class="err-dump">
          <p><span class="err-prompt">guest@zew0z:~$</span> cat <span id="err-path">/missing</span></p>
          <p class="err-fail">cat: <span id="err-fail-path">/missing</span>: No such file or directory</p>
          <p><span class="err-prompt">guest@zew0z:~$</span> ls /</p>
          <ul class="err-ls-list">
            {routes.map((r) => (
              <li>
                <a class="err-ls" href={r.href}><span class="err-mode">{r.mode}</span> {r.name}</a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>
  <script is:inline>
    (function () {
      var path = location.pathname || '/missing';
      var a = document.getElementById('err-path');
      var b = document.getElementById('err-fail-path');
      if (a) a.textContent = path;
      if (b) b.textContent = path;
    })();
  </script>
</BaseLayout>
