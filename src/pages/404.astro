---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 :: zew0z" description="page not found">
  <section class="err-hero">
    <h1 class="err-code">404</h1>
    <p class="err-line">cat: /{Astro.url.pathname}: No such file or directory</p>
    <p class="err-sub">the path you requested doesn't exist on this host. even nmap found nothing.</p>
    <div class="hero-links">
      <a class="btn-primary" href="/">home</a>
      <a class="btn-ghost" href="/writeups.html">writeups</a>
      <a class="btn-ghost" href="/portfolio.html">portfolio</a>
    </div>
  </section>
</BaseLayout>
