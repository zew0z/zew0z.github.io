---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShellPrompt from '../components/ShellPrompt.astro';
import { Icon } from 'astro-icon/components';
import { portfolioItems } from '../lib/portfolio';

const tools = portfolioItems.filter((item) => item.group === 'tools');
const clients = portfolioItems.filter((item) => item.group === 'clients');
const disciplines = portfolioItems.filter((item) => item.group === 'disciplines');
const [feature, ...restTools] = tools;

const starTip = { tabindex: '0', role: 'note', 'aria-label': 'with the help of my AI agent team' };
---

<BaseLayout
  title="portfolio :: zew0z"
  description="Shipped tools, client stores, AI agent pipelines, and the skills behind them."
  crumb="/portfolio"
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <ShellPrompt path="~/portfolio" command="ls -la" />
      <h1 class="page-title">portfolio <span class="count">:: {portfolioItems.length} entries</span></h1>
      <p class="page-lede">
        shipped tools, client sites, and the skills behind them. stars mark work done with my AI agent team.
      </p>
      <p class="pf-total" aria-hidden="true">total {portfolioItems.length} :: 3 dirs</p>
    </div>
  </section>

  <section class="pf-group">
    <div class="container">
      <ShellPrompt path="~/portfolio" command="ls tools/" />
      <h2 class="visually-hidden">tools and frameworks</h2>
      <div class="pf-tools">
        <article class="pf-feature" style={`--tile: ${feature.hue}`}>
          <div class="pf-feature-head">
            <span class="ach-icon" aria-hidden="true"><Icon name={feature.icon} /></span>
            <h3 class="pf-title-lg">
              {feature.title}
              {feature.chip && <span class="wl-chip">{feature.chip}</span>}
            </h3>
          </div>
          <p class="pf-desc">{feature.desc}</p>
          {feature.run && (
            <pre class="pf-run" aria-hidden="true"><span class="t-dim">$</span> {feature.run}<span class="shell-cursor"></span></pre>
          )}
          {feature.meta && (
            <dl class="pf-meta" aria-hidden="true">
              {feature.meta.map(([k, v]) => (
                <div class="pf-meta-row"><dt>{k}</dt><dd>{v}</dd></div>
              ))}
            </dl>
          )}
          <div class="pf-tags">
            {feature.tags.map((t) => <span class="tag">#{t}</span>)}
          </div>
        </article>
        {restTools.map((item) => (
          <article class="pf-tool" style={`--tile: ${item.hue}`}>
            <h3 class="pf-title">
              <span class="pf-tool-icon" aria-hidden="true"><Icon name={item.icon} /></span>
              {item.title}
              {item.chip && <span class="wl-chip">{item.chip}</span>}
              {item.star && (
                <span class="star-tip" {...starTip}>
                  <Icon name="tabler:star-filled" />
                  <span class="tip" aria-hidden="true">with the help of my AI agent team</span>
                </span>
              )}
            </h3>
            <p class="pf-desc">
              {item.desc}
              {item.links && item.links.map((l, i) => (
                <>{i > 0 && ', '}<a href={l.href} target="_blank" rel="noopener">{l.label}</a></>
              ))}
              {item.descAfter && ` ${item.descAfter}`}
            </p>
            <div class="pf-tags">
              {item.tags.slice(0, 2).map((t) => <span class="tag">#{t}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pf-group">
    <div class="container">
      <ShellPrompt path="~/portfolio" command="ls clients/" />
      <h2 class="visually-hidden">client stores</h2>
      <div class="pf-files" role="list">
        {clients.map((item) => (
          <a class="pf-file" role="listitem" style={`--tile: ${item.hue}`} href={item.link} target="_blank" rel="noopener">
            <span class="pf-file-main">
              <span class="pf-file-name">
                {item.title} <span class="ext" aria-hidden="true">↗</span>
                {item.chip && <span class="wl-chip">{item.chip}</span>}
                {item.star && (
                  <span class="star-tip" {...starTip}>
                    <Icon name="tabler:star-filled" />
                    <span class="tip" aria-hidden="true">with the help of my AI agent team</span>
                  </span>
                )}
              </span>
              <span class="pf-file-desc">{item.desc}</span>
            </span>
            <span class="pf-file-tag" aria-hidden="true">#{item.tags[0]}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="pf-group pf-group-last">
    <div class="container">
      <ShellPrompt path="~/portfolio" command="cat disciplines/*" />
      <h2 class="visually-hidden">disciplines</h2>
      <div class="pf-stats">
        {disciplines.map((item) => (
          <article class="pf-stat" style={`--tile: ${item.hue}`}>
            <h3 class="pf-stat-title">
              <span class="pf-stat-icon" aria-hidden="true"><Icon name={item.icon} /></span>
              {item.title}
            </h3>
            <p class="pf-stat-desc">{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
