---
import BaseLayout from '../layouts/BaseLayout.astro';
import AsciiArt from '../components/AsciiArt.astro';
import { ZEW0Z_BANNER, WRITEUPS_BANNER, WORK_BANNER } from '../lib/ascii';
import { portfolioItems } from '../lib/portfolio';
import { getWriteups, postSlug } from '../lib/writeups';

const posts = await getWriteups();
const writeupCount = posts.length;
const projectCount = portfolioItems.length;
const nl = '\n';

const bootLines = [
  { kind: 'dim', text: '[    0.000000] linux 6.12.0-zew0z #1 SMP PREEMPT' },
  { kind: 'head', text: '[    0.000184] bios :: guest@zew0z  rev 2026.09' },
  { kind: 'ok', text: '[    0.041102] cpu0     coffee-powered core          [ ok ]' },
  { kind: 'ok', text: '[    0.082441] mem      64G claimed, 1 room leftover [ ok ]' },
  { kind: 'ok', text: '[    0.120903] acpi     irq routing, no surprises    [ ok ]' },
  { kind: 'ok', text: '[    0.151004] pci      walking the bus              [ ok ]' },
  { kind: 'ok', text: '[    0.188210] net      thm · htb · shopify          [ ok ]' },
  { kind: 'ok', text: '[    0.210440] rng      rdrand online                [ ok ]' },
  { kind: 'ok', text: '[    0.241008] ext4     mounting /writeups           [ ok ]' },
  { kind: 'ok', text: '[    0.301552] ext4     spoiler gates armed          [ ok ]' },
  { kind: 'ok', text: '[    0.366104] ext4     mounting /portfolio          [ ok ]' },
  { kind: 'ok', text: '[    0.401882] audit    sectape hooks                [ ok ]' },
  { kind: 'ok', text: '[    0.421773] docker   agent sandboxes              [ ok ]' },
  { kind: 'ok', text: '[    0.498201] tty1     guest shell on :4321         [ ok ]' },
  { kind: 'ok', text: '[    0.551044] flags    3 hidden, 0 in plaintext     [ ok ]' },
  { kind: 'go', text: '[    0.610000] access granted. continue.' },
];

const cascadeTerms = [
  {
    title: 'recon@lab:~',
    hue: 'teal',
    x: '2%',
    y: '7%',
    w: '22.5rem',
    rot: '-1.4deg',
    z: 3,
    lines: [
      { t: 'cmd', v: '$ nmap -sV -T4 10.10.x.x' },
      { t: 'out', v: 'PORT    STATE SERVICE' },
      { t: 'out', v: '22/tcp  open  ssh' },
      { t: 'out', v: '80/tcp  open  http' },
      { t: 'out', v: '443/tcp open  https' },
    ],
  },
  {
    title: 'build@store:~',
    hue: 'green',
    x: '28%',
    y: '26%',
    w: '21.5rem',
    rot: '1.1deg',
    z: 4,
    lines: [
      { t: 'cmd', v: '$ shopify theme push' },
      { t: 'out', v: '↑  42 files' },
      { t: 'out', v: 'preview → production' },
      { t: 'ok', v: '[ ok ] storefront shipped' },
    ],
  },
  {
    title: 'agent@rig:~',
    hue: 'violet',
    x: '54%',
    y: '5%',
    w: '20.5rem',
    rot: '-0.7deg',
    z: 5,
    lines: [
      { t: 'cmd', v: '$ claude --skills mcp' },
      { t: 'out', v: 'sandbox  docker' },
      { t: 'out', v: 'harness  chained' },
      { t: 'ok', v: '[ ok ] agent team online' },
    ],
  },
  {
    title: 'record@lab:~',
    hue: 'amber',
    x: '6%',
    y: '54%',
    w: '22rem',
    rot: '1.5deg',
    z: 2,
    lines: [
      { t: 'cmd', v: '$ sectape record' },
      { t: 'out', v: 'capturing session…' },
      { t: 'out', v: 'every cmd + stdout' },
      { t: 'ok', v: '[ ok ] audit trail written' },
    ],
  },
  {
    title: 'zew0z@box:~',
    hue: 'sky',
    x: '46%',
    y: '52%',
    w: '21rem',
    rot: '-1.2deg',
    z: 3,
    lines: [
      { t: 'cmd', v: '$ whoami && id' },
      { t: 'out', v: 'zew0z' },
      { t: 'out', v: 'uid=1000(zew0z) gid=1000(pwn)' },
      { t: 'ok', v: 'status: actively pwning' },
    ],
  },
];

const beats = [
  ...bootLines.map((_, i) => ({ kind: 'boot', i })),
  ...cascadeTerms.map((_, i) => ({ kind: 'swarm', i })),
  { kind: 'climax', i: 0 },
];

const logos = [
  { slug: 'tryhackme', name: 'TryHackMe' },
  { slug: 'hackthebox', name: 'Hack The Box' },
  { slug: 'anthropic', name: 'Claude / Anthropic' },
  { slug: 'shopify', name: 'Shopify' },
  { slug: 'wordpress', name: 'WordPress' },
  { slug: 'linux', name: 'Linux' },
  { slug: 'python', name: 'Python' },
  { slug: 'docker', name: 'Docker' },
  { slug: 'github', name: 'GitHub' },
  { slug: 'archlinux', name: 'Arch Linux' },
  { slug: 'neovim', name: 'Neovim' },
  { slug: 'astro', name: 'Astro' },
  { slug: 'nodedotjs', name: 'Node.js' },
  { slug: 'gnubash', name: 'Bash' },
];

const logoLoop = [...logos, ...logos];
const typeLine = 'break boxes. ship stores. document everything.';
const typeLine2 = 'security writeups, client stores, an agent team.';

function bootParts(text: string) {
  const m = text.match(/^(\[[^\]]+\])\s(.*)$/);
  if (!m) return { ts: '', body: text, ok: false };
  const ok = /\s\[ ok \]\s*$/.test(m[2]);
  return {
    ts: m[1],
    body: ok ? m[2].replace(/\s\[ ok \]\s*$/, '') : m[2],
    ok,
  };
}
const listingPosts = posts;
const listingWork = portfolioItems.filter((item) => item.group !== 'disciplines');

const FALL_GLYPHS = '0123456789abcdef│─┌┐└┘┬┴┼┤├█▓▒░<>/$#*+=.~';
function fallRng(seed: number) {
  return function next() {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
function makeFallCol(seed: number, len: number) {
  const rand = fallRng(seed);
  const chars: string[] = [];
  for (let i = 0; i < len; i++) {
    chars.push(FALL_GLYPHS[Math.floor(rand() * FALL_GLYPHS.length)]);
  }
  const body = chars.join('\n');
  return `${body}\n${body}`;
}

const fallCols = Array.from({ length: 16 }, (_, i) => {
  const rand = fallRng(1100 + i * 97);
  return {
    x: 48 + i * 3.2 + (rand() * 1.4 - 0.7),
    dur: 14 + rand() * 16,
    delay: -(rand() * 18),
    hue: i % 5 === 0 ? 'teal' : i % 4 === 0 ? 'green' : i % 3 === 0 ? 'ink' : 'dim',
    text: makeFallCol(200 + i * 13, 42),
  };
});

const fallStrings = [
  { x: 53, dur: 11, delay: -1, text: '$ nmap -sV -T4 10.10.x.x' },
  { x: 62, dur: 14, delay: -4, text: '0x7ffee21a4c00' },
  { x: 58, dur: 12, delay: -2.5, text: 'ext4: mounting /writeups' },
  { x: 70, dur: 16, delay: -7, text: 'guest@zew0z:~$ whoami' },
  { x: 55, dur: 13, delay: -9, text: 'sectape record --audit' },
  { x: 76, dur: 10, delay: -3, text: '22/tcp open ssh' },
  { x: 64, dur: 15, delay: -6, text: 'claude --skills mcp' },
  { x: 59, dur: 12, delay: -11, text: '# spoiler gates armed' },
  { x: 82, dur: 13, delay: -5, text: 'thm top 8%' },
  { x: 67, dur: 17, delay: -8, text: 'docker: agent sandboxes [ ok ]' },
  { x: 72, dur: 11, delay: -13, text: 'shopify theme push' },
  { x: 78, dur: 14, delay: -10, text: '443/tcp open https' },
  { x: 54, dur: 16, delay: -15, text: 'cat /proc/self/status' },
  { x: 73, dur: 12, delay: -12, text: 'uid=1000(zew0z) gid=1000(pwn)' },
  { x: 61, dur: 13, delay: -14, text: '0xffffffff810a4c00' },
  { x: 80, dur: 11, delay: -16, text: 'CAP_SYS_PTRACE' },
  { x: 66, dur: 15, delay: -1.5, text: 'pts/0  guest session' },
];

const fallWords = [
  { x: 52, dur: 16, delay: -2, word: 'ZEW0Z' },
  { x: 60, dur: 13, delay: -6, word: 'PWN' },
  { x: 68, dur: 15, delay: -3, word: 'SSH' },
  { x: 76, dur: 12, delay: -8, word: 'THM' },
  { x: 57, dur: 18, delay: -11, word: 'HTB' },
  { x: 84, dur: 14, delay: -5, word: 'ROOT' },
  { x: 64, dur: 17, delay: -9, word: 'BOX' },
  { x: 72, dur: 14, delay: -4, word: 'ZSH' },
];
const whoami = `user:     zew0z
shell:    /bin/zsh
os:       linux x86_64
uptime:   5+ years
rank:     thm top 8%
rooms:    100+
clients:  8
status:   actively pwning`;
---

<BaseLayout>
  <div id="cinema" class="cinema">
    <section class="cinema-stage" id="cinema-stage" aria-label="system boot">
      <div class="cinema-beats" aria-hidden="true">
        {beats.map((beat, n) => (
          <div
            class="cinema-beat"
            data-kind={beat.kind}
            data-i={beat.i}
            style={`top: ${((n + 0.15) / (beats.length + 4)) * 100}%`}
          />
        ))}
      </div>

      <div class="cinema-sticky">
        <div class="cinema-fall" id="cinema-fall" aria-hidden="true">
          {fallCols.map((col) => (
            <pre
              class={`cinema-fall-col hue-${col.hue}`}
              style={`--x:${col.x}%;--dur:${col.dur}s;--delay:${col.delay}s`}
            >{col.text}</pre>
          ))}
          {fallStrings.map((str) => (
            <span
              class="cinema-fall-str"
              style={`--x:${str.x}%;--dur:${str.dur}s;--delay:${str.delay}s`}
            >{str.text}</span>
          ))}
          {fallWords.map((w) => (
            <pre
              class="cinema-fall-word"
              style={`--x:${w.x}%;--dur:${w.dur}s;--delay:${w.delay}s`}
            >{Array.from({ length: 8 }, () => w.word.split('').join('\n')).join('\n\n')}</pre>
          ))}
        </div>
        <div class="cinema-scan" aria-hidden="true"></div>

        <div class="cinema-boot-layer">
          <pre class="cinema-boot-log" id="boot-log" aria-hidden="true">{bootLines.map((line, i) => {
              const p = bootParts(line.text);
              return (
                <span class={`cinema-boot-line boot-${line.kind}`} data-boot-line={i}>
                  {p.ts ? <span class="boot-ts">{p.ts} </span> : null}{p.body}{p.ok ? <span class="boot-st"> [ ok ]</span> : null}{nl}
                </span>
              );
            })}</pre>
          <div class="cinema-pct-wrap">
            <p class="cinema-pct-label" id="boot-label">loading</p>
            <p class="cinema-pct" id="boot-pct">00</p>
            <div class="cinema-pct-bar" aria-hidden="true">
              <div class="cinema-boot-fill" id="boot-fill"></div>
            </div>
          </div>
        </div>

        <div class="cinema-swarm" id="cascade-rail">
          {cascadeTerms.map((term, i) => (
            <article
              class={`cinema-term hue-${term.hue}`}
              data-cascade={i}
              style={`--tx:${term.x};--ty:${term.y};--tw:${term.w};--rot:${term.rot};--z:${term.z};--i:${i}`}
            >
              <div class="cinema-term-chrome" aria-hidden="true">
                <span class="tdot tdot-r"></span>
                <span class="tdot tdot-y"></span>
                <span class="tdot tdot-g"></span>
                <span class="tname">{term.title}</span>
              </div>
              <pre class="cinema-term-body">{term.lines.map((line) => (
                  <span class={`cinema-term-line is-${line.t}`}>{line.v}{nl}</span>
                ))}</pre>
            </article>
          ))}
        </div>

        <div class="cinema-climax" id="ascii-reveal">
          <h1 class="hero-name visually-hidden">zew0z</h1>
          <AsciiArt art={ZEW0Z_BANNER} class="ascii-hero cinema-ascii" label="zew0z ascii logo" />
          <div class="cinema-type" aria-live="polite" data-type-line={typeLine} data-type-line-2={typeLine2}>
            <div class="cinema-type-row">
              <span class="cinema-type-prompt" aria-hidden="true">guest@zew0z:~$</span>
              <p class="cinema-type-out" id="type-out"></p>
              <span class="cinema-type-cursor" id="type-cursor-1" aria-hidden="true"></span>
            </div>
            <div class="cinema-type-row" id="type-row-2">
              <span class="cinema-type-prompt is-hash" aria-hidden="true">#</span>
              <p class="cinema-type-out cinema-type-out-2" id="type-out-2"></p>
              <span class="cinema-type-cursor is-dim" id="type-cursor-2" aria-hidden="true"></span>
            </div>
          </div>
        </div>

        <div class="cinema-hud" aria-hidden="true">
          <span id="boot-hud-tty">tty1</span>
          <span id="boot-hud-pct">00%</span>
          <span>flags 3 hidden</span>
          <span>guest@zew0z</span>
        </div>
        <p class="visually-hidden">Scroll to advance the boot sequence, then continue down the page.</p>
      </div>
    </section>

    <section class="cinema-land" aria-label="destinations">
      <div class="container cinema-land-grid">
          <a class="cinema-card card-writeups" href="/writeups.html" aria-label="writeups">
          <span class="cinema-card-path">./writeups</span>
          <AsciiArt art={WRITEUPS_BANNER} class="cinema-card-ascii" />
          <span class="cinema-card-desc">spoiler-gated labs. flags stay offline.</span>
          <pre class="cinema-ls" aria-hidden="true"><span class="cinema-ls-head"># ls -1{nl}</span>{listingPosts.map((post) => (
              <span class={`cinema-ls-row case-${post.data.platform}`}>-rw-  {postSlug(post)}{nl}</span>
            ))}</pre>
          <span class="cinema-card-meta">{writeupCount} rooms catalogued</span>
        </a>

          <a class="cinema-card card-portfolio" href="/portfolio.html" aria-label="portfolio">
          <span class="cinema-card-path">./portfolio</span>
          <AsciiArt art={WORK_BANNER} class="cinema-card-ascii" />
          <span class="cinema-card-desc">tools, client stores, frameworks in production.</span>
          <pre class="cinema-ls" aria-hidden="true"><span class="cinema-ls-head"># ls -1{nl}</span>{listingWork.map((item) => (
              <span class="cinema-ls-row">{item.group === 'clients' ? 'lrwx' : '-rwx'}  {item.title}{nl}</span>
            ))}</pre>
          <span class="cinema-card-meta">{projectCount} entries</span>
        </a>

        <aside class="cinema-card card-stats hero-panel" aria-label="stats">
          <div class="panel-chrome">
            <span class="panel-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="panel-title">whoami --verbose</span>
          </div>
          <pre class="panel-dump" aria-hidden="true">{whoami}</pre>
          <dl class="hero-stats visually-hidden">
            <div class="hero-stat"><dt>thm rooms</dt><dd>100+</dd></div>
            <div class="hero-stat"><dt>platform rank</dt><dd>top 8%</dd></div>
            <div class="hero-stat"><dt>years on linux</dt><dd>5+</dd></div>
            <div class="hero-stat"><dt>projects</dt><dd>{projectCount}</dd></div>
          </dl>
        </aside>
      </div>
    </section>

    <section class="cinema-logos" aria-label="tools and platforms">
      <div class="cinema-logos-fade" aria-hidden="true"></div>
      <div class="cinema-marquee" data-marquee>
        <div class="cinema-marquee-track">
          {logoLoop.map((logo, i) => (
            <span class="cinema-logo" aria-hidden={i >= logos.length ? 'true' : 'false'}>
              <img
                src={`/assets/logos/${logo.slug}.svg`}
                alt=""
                width="40"
                height="40"
                loading="lazy"
                decoding="async"
              />
              {i < logos.length ? <span class="visually-hidden">{logo.name}</span> : null}
            </span>
          ))}
        </div>
      </div>
    </section>
  </div>

  <script src="../scripts/cinematic.js"></script>
</BaseLayout>
