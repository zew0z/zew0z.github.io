---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import { portfolioItems } from '../lib/portfolio';
import { getWriteups, postUrl, readMinutes, searchItem, shortTitle } from '../lib/writeups';

const posts = await getWriteups();
const previewWork = portfolioItems.slice(0, 3);
const previewPosts = posts.slice(0, 4);
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 class="hero-name">zew0z<span class="grad">.</span></h1>
        <p class="hero-role">I break boxes, build storefronts, and ship with an AI agent team.</p>
        <p class="hero-bio">
          CTF writeups in the top 8% on TryHackMe, live WooCommerce stores, and agent pipelines that finish the boring work.
        </p>
        <div class="hero-links">
          <a class="btn-primary" href="/portfolio.html">portfolio</a>
          <a class="btn-ghost" href="/writeups.html">writeups</a>
        </div>
      </div>
      <aside class="hero-panel" aria-label="quick facts">
        <dl class="hero-stats">
          <div class="hero-stat"><dt>thm rooms</dt><dd>100+</dd></div>
          <div class="hero-stat"><dt>platform rank</dt><dd>top 8%</dd></div>
          <div class="hero-stat"><dt>years on linux</dt><dd>5+</dd></div>
          <div class="hero-stat"><dt>projects &amp; clients</dt><dd>8</dd></div>
        </dl>
        <div class="hero-panel-links">
          <a href="https://github.com/zew0z" target="_blank" rel="noopener">github/zew0z</a>
          <a href="https://ko-fi.com/zew0z" target="_blank" rel="noopener">ko-fi/zew0z</a>
          <a href="/feed.xml">rss</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section preview-section" id="work">
    <div class="container">
      <div class="preview-head">
        <h2 class="section-title">selected work</h2>
        <a class="preview-more" href="/portfolio.html">full portfolio →</a>
      </div>
      <p class="section-sub">three recent ships. tools, client stores, and frameworks in production.</p>
      <PortfolioGrid items={previewWork} compact />
    </div>
  </section>

  <section class="section preview-section preview-writeups" id="writeups">
    <div class="container">
      <div class="preview-head">
        <h2 class="section-title">latest writeups</h2>
        <a class="preview-more" href="/writeups.html">all {posts.length} →</a>
      </div>
      <p class="section-sub">spoiler-gated labs from TryHackMe, HTB, and a few notes in between.</p>

      <div class="preview-cases">
        {previewPosts.map((post) => (
          <a class={`preview-case case-${post.data.platform}`} href={postUrl(post)}>
            <span class="preview-case-meta">
              <span class={`badge badge-${post.data.platform}`}>{post.data.platform}</span>
              <span class="preview-case-date">{post.data.date.toISOString().slice(0, 10)}</span>
              <span class="preview-case-read">~{readMinutes(post)} min</span>
            </span>
            <span class="preview-case-title">{shortTitle(post)}</span>
            <span class="preview-case-desc">{post.data.description}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="playground section" id="playground">
    <div class="container playground-grid">
      <div class="playground-copy">
        <h2 class="section-title">the playground</h2>
        <p>
          a fake shell with real opinions. it knows the catalog, it hides one actual flag,
          and it keeps score of what you unlock.
        </p>
        <p class="mono-hint">start with <code>help</code>, or go straight for <code>nmap</code> and <code>wiki</code>.</p>
        <p class="mono-hint">capture the flag to claim a spot on the flag board.</p>
      </div>
      <div>
        <div class="term" id="guest-term">
          <div class="term-chrome" aria-hidden="true">
            <span class="tdot tdot-r"></span><span class="tdot tdot-y"></span><span class="tdot tdot-g"></span>
            <span class="tname">guest@zew0z: ~</span>
          </div>
          <div class="term-out" id="term-out" role="log" aria-label="guest terminal output"></div>
          <form class="term-line" id="term-form" autocomplete="off">
            <label class="term-prompt" for="term-input">guest@zew0z:~$</label>
            <input class="term-input" id="term-input" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="guest terminal input. type help for commands." />
          </form>
        </div>
        <div class="flagboard">
          <div class="flagboard-head">flagboard :: hunters who checked the source</div>
          <div class="flagboard-rows" id="flagboard-rows"></div>
          <p class="flagboard-join">join: capture the flag hiding in the shell, then run publish</p>
        </div>
      </div>
    </div>
  </section>

  <script id="site-data" type="application/json" set:html={JSON.stringify({ posts: posts.map(searchItem) })} />
  <script src="../scripts/terminal.js"></script>
</BaseLayout>
