---
import BaseLayout from '../layouts/BaseLayout.astro';
import AsciiArt from '../components/AsciiArt.astro';
import ShellPrompt from '../components/ShellPrompt.astro';
import WorkListing from '../components/WorkListing.astro';
import { ZEW0Z_BANNER, DIVIDER } from '../lib/ascii';
import { portfolioItems } from '../lib/portfolio';
import { getWriteups, postUrl, readMinutes, searchItem, shortTitle } from '../lib/writeups';

const posts = await getWriteups();
const previewWork = portfolioItems.slice(0, 4);
const previewPosts = posts.slice(0, 5);
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <ShellPrompt path="~" command="cat banner.txt" />
        <AsciiArt art={ZEW0Z_BANNER} class="ascii-hero" label="zew0z ascii banner" />
        <p class="hero-motd" aria-hidden="true">
          <span class="t-dim"># motd</span> break boxes. ship stores. document everything.
        </p>
        <h1 class="hero-name visually-hidden">zew0z</h1>
        <p class="hero-role">security writeups, client storefronts, and an AI agent team that ships.</p>
        <div class="hero-links">
          <a class="btn-primary" href="/portfolio.html">./portfolio</a>
          <a class="btn-ghost" href="/writeups.html">./writeups</a>
        </div>
      </div>

      <aside class="hero-panel" aria-label="system status">
        <div class="panel-chrome">
          <span class="panel-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="panel-title">whoami --verbose</span>
        </div>
        <pre class="panel-dump" aria-hidden="true">{`user:     zew0z
shell:    /bin/zsh
os:       linux x86_64
uptime:   5+ years
rank:     thm top 8%
rooms:    100+
clients:  8
status:   actively pwning (labs)`}</pre>
        <dl class="hero-stats visually-hidden">
          <div class="hero-stat"><dt>thm rooms</dt><dd>100+</dd></div>
          <div class="hero-stat"><dt>platform rank</dt><dd>top 8%</dd></div>
          <div class="hero-stat"><dt>years on linux</dt><dd>5+</dd></div>
          <div class="hero-stat"><dt>projects &amp; clients</dt><dd>8</dd></div>
        </dl>
        <div class="hero-panel-links">
          <a href="https://github.com/zew0z" target="_blank" rel="noopener">github</a>
          <a href="https://ko-fi.com/zew0z" target="_blank" rel="noopener">ko-fi</a>
          <a href="/feed.xml">rss</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section preview-section" id="work">
    <div class="container">
      <ShellPrompt path="~/portfolio" command="ls -la | head" />
      <div class="preview-head">
        <h2 class="section-title">selected work</h2>
        <a class="preview-more" href="/portfolio.html">cd portfolio →</a>
      </div>
      <p class="section-sub">tools, client stores, and frameworks currently in production.</p>
      <WorkListing items={previewWork} />
    </div>
  </section>

  <section class="section preview-section preview-writeups" id="writeups">
    <div class="container">
      <ShellPrompt path="~/writeups" command={`ls -1 | head -${previewPosts.length}`} />
      <div class="preview-head">
        <h2 class="section-title">latest writeups</h2>
        <a class="preview-more" href="/writeups.html">cd writeups →</a>
      </div>
      <p class="section-sub">spoiler-gated labs. flags stay offline; notes stay here.</p>

      <div class="preview-log" role="list">
        {previewPosts.map((post, i) => (
          <a class={`preview-log-row case-${post.data.platform}`} href={postUrl(post)} role="listitem">
            <span class="plog-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="plog-body">
              <span class="plog-title">{shortTitle(post)}</span>
              <span class="plog-desc">{post.data.description}</span>
            </span>
            <span class="plog-meta">
              <span class={`badge badge-${post.data.platform}`}>{post.data.platform}</span>
              <span>{post.data.date.toISOString().slice(0, 10)}</span>
              <span>~{readMinutes(post)}m</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="playground section" id="playground">
    <div class="container playground-grid">
      <div class="playground-copy">
        <ShellPrompt path="~/playground" command="./guest-shell" />
        <h2 class="section-title">guest shell</h2>
        <p>
          a fake shell with real opinions. it indexes the writeups, hides one flag,
          and keeps score of what you unlock.
        </p>
        <pre class="ascii-hint" aria-hidden="true">{`${DIVIDER}
$ help | nmap | wiki | cat flag.txt
${DIVIDER}`}</pre>
        <p class="mono-hint">rumor: <code>cat flag.txt</code> is not the way. view-source is.</p>
      </div>
      <div>
        <div class="term" id="guest-term">
          <div class="term-chrome" aria-hidden="true">
            <span class="tdot tdot-r"></span><span class="tdot tdot-y"></span><span class="tdot tdot-g"></span>
            <span class="tname">guest@zew0z: ~</span>
          </div>
          <div class="term-out" id="term-out" role="log" aria-label="guest terminal output"></div>
          <form class="term-line" id="term-form" autocomplete="off">
            <label class="term-prompt" for="term-input">guest@zew0z:~$</label>
            <input class="term-input" id="term-input" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="guest terminal input. type help for commands." />
          </form>
        </div>
        <div class="flagboard">
          <div class="flagboard-head"># flagboard :: hunters who checked the source</div>
          <div class="flagboard-rows" id="flagboard-rows"></div>
          <p class="flagboard-join">join: capture the flag, then run publish</p>
        </div>
      </div>
    </div>
  </section>

  <script id="site-data" type="application/json" set:html={JSON.stringify({ posts: posts.map(searchItem) })} />
  <script src="../scripts/terminal.js"></script>
</BaseLayout>
