---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { postSlug, postUrl, readMinutes, shortTitle, type Writeup } from '../lib/writeups';

interface Props {
  posts: Writeup[];
  searchable?: boolean;
}

const { posts, searchable = true } = Astro.props;
const [featured, ...rest] = posts;

// platform badge + difficulty already carry this info; show only distinctive tags
const BOILERPLATE_TAGS = new Set(['tryhackme', 'htb', 'hackthebox', 'ctf', 'blog', 'writeup', 'writeups', 'cybersecurity']);
const displayTags = (tags: string[]) => tags.filter((t) => !BOILERPLATE_TAGS.has(t)).slice(0, 3);

function haystack(post: Writeup): string {
  return `${post.data.title} ${post.data.description} ${post.data.tags.join(' ')} ${post.body || ''}`.toLowerCase();
}

const coverFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/img/covers/*.jpg', { eager: true });

const COVER_BY_SLUG: Record<string, { file: string; alt: string }> = {
  'bounty-hacker-tryhackme': { file: 'bounty-hacker', alt: 'tryhackme room title still for bounty hacker' },
  'agent-sudo-tryhackme': { file: 'agent-sudo', alt: 'tryhackme room title still for agent sudo' },
  'crack-the-hash-tryhackme': { file: 'crack-the-hash', alt: 'tryhackme room title still for crack the hash' },
  'c4ptur3-th3-fl4g-tryhackme': { file: 'c4ptur3', alt: 'tryhackme room title still for c4ptur3-th3-fl4g' },
  'simple-ctf-tryhackme': { file: 'simple-ctf', alt: 'apache default title screen from the simple ctf room' },
  'mr-robot-ctf': { file: 'mr-robot', alt: 'tryhackme room title still for mr robot' },
  'pickle-rick-ctf': { file: 'pickle-rick', alt: 'tryhackme room title still for pickle rick' },
  'rootme': { file: 'rootme', alt: 'platform-colored title still for the rootme writeup' },
  'flag-command-htb': { file: 'flag-command', alt: 'blurred title still of the flag command challenge screen' },
  'ai-ruined-my-life': { file: 'ai-ruined-my-life', alt: 'platform-colored title still for the blog post' },
};

function coverOf(post: Writeup): { src: ImageMetadata; alt: string } | null {
  const spec = COVER_BY_SLUG[postSlug(post)];
  if (!spec) return null;
  const mod = coverFiles[`../assets/img/covers/${spec.file}.jpg`];
  if (!mod) return null;
  return { src: mod.default, alt: spec.alt };
}
---

{searchable && (
  <div class="catalog-tools">
    <div class="search-wrap">
      <span class="search-icon" aria-hidden="true">&gt;_</span>
      <input class="search-input" id="search-input" type="search" placeholder="search rooms…" aria-label="search writeups" autocomplete="off" spellcheck="false" />
      <span class="search-key" aria-hidden="true">/</span>
    </div>
    <div class="chip-row" role="group" aria-label="filter by platform">
      <button class="chip is-active" type="button" data-platform="all">all</button>
      <button class="chip" type="button" data-platform="thm"><span class="dot thm" aria-hidden="true"></span>tryhackme</button>
      <button class="chip" type="button" data-platform="htb"><span class="dot htb" aria-hidden="true"></span>htb</button>
      <button class="chip" type="button" data-platform="blog"><span class="dot blog" aria-hidden="true"></span>blog</button>
    </div>
  </div>
)}

{searchable && (
  <p class="result-line" id="result-line" role="status">showing all {posts.length}</p>
)}

{featured && (
  <article
    class={`term wu-feature case-${featured.data.platform}`}
    data-platform={featured.data.platform}
    data-haystack={haystack(featured)}
  >
    <div class="term-chrome" aria-hidden="true">
      <span class="tdot tdot-r"></span>
      <span class="tdot tdot-y"></span>
      <span class="tdot tdot-g"></span>
      <span class="tname">guest@zew0z: ~/writeups/{postSlug(featured)}.md</span>
    </div>
    <div class="wu-feature-body">
      <div class="wu-feature-copy">
        <p class="pf-path">./latest</p>
        <div class="case-top">
          <h2 class="case-title"><a href={postUrl(featured)}>{shortTitle(featured)}</a></h2>
          <span class={`badge badge-${featured.data.platform}`}>{featured.data.platform}</span>
          {featured.data.difficulty && <span class={`diff diff-${featured.data.difficulty.replace(' ', '-')}`}>{featured.data.difficulty}</span>}
        </div>
        <p class="case-desc">{featured.data.description}</p>
        <div class="case-tags">
          {displayTags(featured.data.tags).map((t) => <button class="tag" type="button" data-q={t}>#{t}</button>)}
        </div>
      </div>
      <div class="wu-feature-meta">
        <pre class="pf-run" aria-hidden="true"><span class="t-dim">$</span> cat {postSlug(featured)}.md<span class="shell-cursor"></span></pre>
        <dl class="whoami-strip pf-term-meta">
          <div><dt>date</dt><dd>{featured.data.date.toISOString().slice(0, 10)}</dd></div>
          <div><dt>read</dt><dd>~{readMinutes(featured)} min</dd></div>
          {featured.data.room && (
            <div>
              <dt>room</dt>
              <dd><a href={`https://tryhackme.com/room/${featured.data.room}`} target="_blank" rel="noopener">open ↗</a></dd>
            </div>
          )}
        </dl>
      </div>
    </div>
  </article>
)}

<div class="case-list" id="case-list">
  {rest.map((post) => {
    const cover = coverOf(post);
    return (
    <article
      class={`case case-${post.data.platform}${cover ? ' has-cover' : ''}`}
      data-platform={post.data.platform}
      data-haystack={haystack(post)}
    >
      <div class="case-spine" aria-hidden="true"></div>
      {cover && (
        <figure class="case-cover">
          <a href={postUrl(post)} tabindex="-1">
            <Image
              src={cover.src}
              alt={cover.alt}
              widths={[480, 800, 1200]}
              sizes="(max-width: 720px) 100vw, 42rem"
              loading="lazy"
              decoding="async"
            />
          </a>
        </figure>
      )}
      <div class="case-main">
        <div class="case-top">
          <h2 class="case-title"><a href={postUrl(post)}>{shortTitle(post)}</a></h2>
          <span class={`badge badge-${post.data.platform}`}>{post.data.platform}</span>
          {post.data.difficulty && <span class={`diff diff-${post.data.difficulty.replace(' ', '-')}`}>{post.data.difficulty}</span>}
        </div>
        <p class="case-desc">{post.data.description}</p>
        <div class="case-tags">
          {displayTags(post.data.tags).map((t) => <button class="tag" type="button" data-q={t}>#{t}</button>)}
        </div>
      </div>
      <div class="case-side">
        <div class="case-when">
          <span>{post.data.date.toISOString().slice(0, 10)}</span>
          <span>~{readMinutes(post)} min</span>
        </div>
        {post.data.room && <a href={`https://tryhackme.com/room/${post.data.room}`} target="_blank" rel="noopener">room ↗</a>}
      </div>
    </article>
    );
  })}
</div>

{searchable && (
  <div class="case-empty" id="case-empty" hidden>
    <p>nothing matches that query. <button class="chip" type="button" id="search-reset">clear search</button></p>
  </div>
)}
