---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  eager?: boolean;
  sizes?: string;
}

const {
  src,
  alt,
  caption,
  eager = false,
  sizes = '(max-width: 720px) 100vw, 42vw',
} = Astro.props;
---

<figure class="pf-still">
  <Image
    src={src}
    alt={alt}
    widths={[480, 800, 1200]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
  {caption && <figcaption class="pf-still-cap">{caption}</figcaption>}
</figure>
