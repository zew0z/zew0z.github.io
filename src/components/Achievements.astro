---
import PortfolioGrid from './PortfolioGrid.astro';
import { portfolioItems } from '../lib/portfolio';
---

<section class="section" id="record">
  <div class="container">
    <div class="section-head">
      <div>
        <h2 class="section-title">the record <span class="count">:: work &amp; achievements</span></h2>
        <p class="section-sub">shipped tools, client sites and the skills behind them. hover the stars for the fine print.</p>
      </div>
    </div>

    <PortfolioGrid items={portfolioItems} />
  </div>
</section>
