---
import { Icon } from 'astro-icon/components';
import type { PortfolioItem } from '../lib/portfolio';

interface Props {
  items: PortfolioItem[];
}

const { items } = Astro.props;

function modeOf(item: PortfolioItem): string {
  if (item.link || item.links?.length) return 'lrwxr-xr-x';
  if (item.chip === 'own tool' || item.chip === 'open source') return '-rwxr-xr-x';
  return '-rw-r--r--';
}
---

<div class="work-listing" role="list">
  <div class="work-listing-head" aria-hidden="true">
    <span class="wl-mode">perms</span>
    <span class="wl-name">name</span>
    <span class="wl-chip">type</span>
  </div>
  {items.map((item) => (
    <article class="work-row" role="listitem" style={`--tile: ${item.hue}`}>
      <span class="wl-mode" aria-hidden="true">{modeOf(item)}</span>
      <div class="wl-main">
        <h3 class="wl-title">
          {item.link ? (
            <a href={item.link} target="_blank" rel="noopener">{item.title} <span class="ext" aria-hidden="true">↗</span></a>
          ) : (
            <span>{item.title}</span>
          )}
          {item.star && (
            <span class="star-tip" tabindex="0" role="note" aria-label="with the help of my AI agent team">
              <Icon name="tabler:star-filled" />
              <span class="tip" aria-hidden="true">with the help of my AI agent team</span>
            </span>
          )}
        </h3>
        <p class="wl-desc">
          {item.desc}
          {item.links && item.links.map((l, i) => (
            <>{i > 0 && ', '}<a href={l.href} target="_blank" rel="noopener">{l.label}</a></>
          ))}
          {item.descAfter && ` ${item.descAfter}`}
        </p>
      </div>
      {item.chip && <span class="wl-chip">{item.chip}</span>}
    </article>
  ))}
</div>
